# VOICERO Cal.diy dev install — environment template (task 1.7)
#
# Committed at the fork root as `.env.dev.example`; on VPS A create the
# real `.env.dev` from it and fill the secrets ONLY through the approved
# secret flow. NEVER commit `.env.dev` (covered by `.env.*` in
# `.gitignore`) and NEVER paste a real secret into this template or any log.
#
# All URLs use the guarded loopback ports from docker-compose.dev.yml
# (web 3300, API v2 3301, Redis 6381, Studio 5555; Postgres has no host
# port). DATABASE_URL uses the in-network service DNS `database:5432` —
# never a host port, never a production connection string (guard R9).

# --- Postgres (dev only; in-network, no host port) ---
POSTGRES_USER=caldev_user
POSTGRES_PASSWORD=CHANGE-ME-USE-A-STRONG-RANDOM-PASSWORD
POSTGRES_DB=calendso
DATABASE_URL=postgresql://caldev_user:CHANGE-ME-USE-A-STRONG-RANDOM-PASSWORD@database:5432/calendso

# --- Redis (dev only, loopback 6381) ---
REDIS_URL=redis://redis:6379

# --- App URLs (loopback dev install) ---
NEXT_PUBLIC_WEBAPP_URL=http://127.0.0.1:3300
NEXT_PUBLIC_WEBSITE_URL=http://127.0.0.1:3300
NEXTAUTH_URL=http://127.0.0.1:3300
NEXT_PUBLIC_API_V2_URL=http://127.0.0.1:3301/api/v2

# --- Secrets: fill via the approved flow, never commit real values ---
# Generate with e.g. `openssl rand -base64 32` on VPS A at setup time.
NEXTAUTH_SECRET=CHANGE-ME-GENERATE-ON-VPS-A
CALENDSO_ENCRYPTION_KEY=CHANGE-ME-GENERATE-ON-VPS-A
JWT_SECRET=CHANGE-ME-GENERATE-ON-VPS-A

# --- Dev-install behaviour ---
# Signup disabled for the dev install (task 1.7). First-admin creation
# with signup disabled is an open item for 1.8 — see README.md.
NEXT_PUBLIC_DISABLE_SIGNUP=true
CALCOM_TELEMETRY_DISABLED=1
LOG_LEVEL=info

# --- Email: intentionally unset for the dev install ---
# Cal.diy sends no mail from the dev install; VOICERO owns transactional
# mail. Do not point EMAIL_SERVER_* at a real SMTP host here.
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=

# --- Stripe: inert boot placeholders (1.8) ---
# The API v2 app THROWS at boot if STRIPE_API_KEY / STRIPE_WEBHOOK_SECRET
# are absent (apps/api/v2/src/config/app.ts:39-40, getEnv with no fallback).
# The dev install therefore sets clearly-fake placeholder values; the
# Stripe billing module is dead EE debris (task 1.11) and
# IS_TEAM_BILLING_ENABLED=false, so no real Stripe call can ever be made.
# NEVER replace these with real keys without a founder decision.
STRIPE_API_KEY=sk_test_dev_placeholder_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_dev_placeholder_not_a_real_secret

# --- Deliberately absent ---
# No CALCOM_LICENSE_KEY, no Google OAuth client credentials:
# per-business calendar wiring is Phase 2 (task 2.8). Adding any of
# these needs its own task and decision; do not improvise values here.
