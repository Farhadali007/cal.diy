# Environment files (never bake real secrets into images)
# The API Dockerfile does a full COPY . . — without this, the real
# .env.dev from the build checkout lands in the image (found at 1.9:
# the 1.8 API image contained the live dev secrets). Templates stay.
.env
.env.dev
.env.local
.env.*.local

# Dependencies
node_modules
**/node_modules

# Build outputs
.next
**/.next
dist
**/dist
build
**/build

# Git
.git
.github

# Testing
coverage
**/coverage
test-results
**/test-results
.turbo
**/.turbo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Examples and docs
docs
